# --- Database (Neon Postgres or any Postgres URL) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth ---
# Any long random string. Used to sign session cookies.
AUTH_SECRET="replace-with-a-long-random-string"

# --- Secret-at-rest encryption ---
# Any long random string. Used ONLY to encrypt/decrypt each user's
# Resend API key before it is stored in the database. Never sent
# anywhere else.
APP_ENCRYPTION_KEY="replace-with-a-different-long-random-string"

# --- Cron ---
# Optional. If set, /api/queue/process requires this as a Bearer
# token (Vercel's own cron requests are allowed through automatically
# via the x-vercel-cron header, so this is mainly for protecting the
# endpoint if you trigger it from an external scheduler like
# cron-job.org instead of Vercel Cron).
CRON_SECRET=""

# NOTE: There is intentionally no RESEND_API_KEY, RESEND_FROM_EMAIL,
# RESEND_FROM_NAME, or RESEND_REPLY_TO here. Each user enters their
# own Resend credentials from the Settings panel in the app after
# logging in — nothing Resend-related is configured via .env.
